# Anthropic / 阿里云百炼 API 配置
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3-coder-plus

# 云效配置
YUNXIAO_ACCESS_TOKEN=your_yunxiao_token_here
YUNXIAO_ORG_ID=your_organization_id_here

# 飞书配置（bi-weekly-doc 任务 / lark-bot 长连接机器人使用）
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# Dify 配置（lark-bot 转发消息用）
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=your_dify_app_api_key

# MySQL 配置（lark-bot 对话记录存储，见 lark_bot_conversations 表）
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=your_mysql_database
DB_CHARSET=utf8mb4


