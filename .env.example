# 运行时选择：claude 或 openai
AGENT_PROVIDER=claude

# Claude / Anthropic 兼容 API 配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=GLM-5.3-Flash

# OpenAI 兼容 API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/v1
OPENAI_MODEL=GLM-5.3-Flash
OPENAI_API_MODE=responses

# OpenAI 路径由 my-agent 通过 HTTP 连接 MCP，并转换为普通 function tools
YUNXIAO_MCP_URL=https://openapi-rdc.aliyuncs.com/ai/mcp?toolsets=code-management
YUNXIAO_TOOLSETS=code-management
YUNXIAO_MCP_TIMEOUT=60
# 进入模型上下文前的 MCP 结果保护（字符数）
YUNXIAO_MCP_CONTEXT_MAX_CHARS=160000
YUNXIAO_MCP_RESULT_MAX_CHARS=60000

# 云效配置
YUNXIAO_ACCESS_TOKEN=your_yunxiao_token_here
YUNXIAO_ORG_ID=your_organization_id_here

# 飞书机器人身份必须隔离：Dify 问答和 Code Review 分别创建飞书应用，不能复用凭证。
# Dify 问答机器人（python cli.py lark-bot）
LARK_DIFY_APP_ID=your_dify_lark_app_id
LARK_DIFY_APP_SECRET=your_dify_lark_app_secret

# Code Review 机器人（python cli.py lark-code-review-bot；--reply-to-lark 回传也使用它）
LARK_CODE_REVIEW_APP_ID=your_code_review_lark_app_id
LARK_CODE_REVIEW_APP_SECRET=your_code_review_lark_app_secret
LARK_CODE_REVIEW_CHAT_ID=oc_7ff28089a62b19bf781ca9fa2ac3275d

# 非机器人常驻任务（例如 bi-weekly-doc）仍使用这套应用凭证。
LARK_APP_ID=your_automation_lark_app_id
LARK_APP_SECRET=your_automation_lark_app_secret

# Dify 配置（lark-bot 转发消息用）
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=your_dify_app_api_key

# Dify 知识库（dataset）API 配置——知识盲区自动补全用
# 注意：这里必须是「知识库 -> Service API」里单独创建的密钥（dataset-/ds- 前缀），
# 不是上面那个 app- 前缀的应用密钥；用错会静默 401。
DIFY_DATASET_API_KEY=your_dify_dataset_api_key
DIFY_DATASET_ID=your_dify_dataset_id

# 知识盲区补全：本地知识文档目录 + 被检索的代码库位置
# Docker 部署时这两个都由宿主机挂载进来，绝不要写死路径
KNOWLEDGE_DOCS_DIR=./knowledge/docs
FBI_REPO_PATH=/path/to/fbi
KB_CHUNK_MAX_TOKENS=1000
KB_MAX_CONCURRENT_FILLS=1

# MySQL 配置（lark-bot 对话记录存储，见 lark_bot_conversations 表）
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=your_mysql_database
DB_CHARSET=utf8mb4
